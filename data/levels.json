  "sources": [
    {
      "id": "src-acl-eval",
      "title": "Cisco IOS XE 17 ACLs Configuration Guide: Access Control Lists",
      "url": "https://www.cisco.com/c/en/us/td/docs/switches/lan/c9000/security/acls/acls-configuration-guide/access-control-lists.html",
      "section": "How ACLs work",
      "claim": "The device tests a packet against the conditions in an access list one by one, and the first match decides whether the packet is accepted or rejected. Because it stops testing after the first match, the order of the conditions in the list is critical."
    },
    {
      "id": "src-acl-implicit",
      "title": "Cisco IOS XE 17 ACLs Configuration Guide: Access Control Lists",
      "url": "https://www.cisco.com/c/en/us/td/docs/switches/lan/c9000/security/acls/acls-configuration-guide/access-control-lists.html",
      "section": "How to configure IPv4 access control lists, Create extended named ACLs",
      "claim": "The end of an extended named ACL contains an implicit deny statement for everything: a packet that matches no condition is rejected (implicit deny)."
    },
    {
      "id": "src-acl-syntax",
      "title": "Cisco IOS XE Catalyst SD-WAN Qualified Command Reference Guide: ACL Commands",
      "url": "https://www.cisco.com/c/en/us/td/docs/routers/sdwan/command/iosxe/qualified-cli-command-reference-guide/m-acl-commands.html",
      "section": "permit (the protocol and any/host keywords)",
      "claim": "An extended ACL entry names the protocol to match (such as tcp, udp, or icmp). The keyword ip matches any Internet protocol, including ICMP, TCP, and UDP. The keywords any and host stand for any address and for one single host."
    },
    {
      "id": "src-cidr",
      "title": "RFC 4632: Classless Inter-domain Routing (CIDR): The Internet Address Assignment and Aggregation Plan (BCP 122)",
      "url": "https://www.rfc-editor.org/rfc/rfc4632",
      "section": "3.1 Basic Concept and Prefix Notation",
      "claim": "A prefix is written as an address followed by a slash and a decimal value between 0 and 32 that describes the number of significant bits, which make explicit which bits of the address are the network prefix. (The game writes ranges this way instead of Cisco's wildcard masks.)"
    }
  ],
